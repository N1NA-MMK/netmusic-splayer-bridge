{
  "schemaVersion": 1,
  "id": "netmusic_splayer_bridge",
  "version": "${version}",
  "name": "Net Music: SPlayer Bridge",
  "description": "为 NetMusic 提供 SPlayer 音源支持：播放 VIP 歌曲时由服务端向 SPlayer 取解锁直链，客户端自行从 CDN 播放，并修正 FLAC 播放与歌词同步。",
  "authors": [
    "SPlayerBridge"
  ],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    {
      "config": "splayerbridge.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "com.splayerbridge.netmusic.SPlayerBridge"
    ],
    "client": [
      "com.splayerbridge.netmusic.client.SPlayerBridgeClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "netmusic": ">=1.5.0"
  }
}
